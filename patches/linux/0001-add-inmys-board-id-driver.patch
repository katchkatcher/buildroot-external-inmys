diff -urN a/Documentation/devicetree/bindings/misc/inmys,board-id.yaml b/Documentation/devicetree/bindings/misc/inmys,board-id.yaml
--- a/Documentation/devicetree/bindings/misc/inmys,board-id.yaml	1970-01-01 00:00:00.000000000 +0000
+++ b/Documentation/devicetree/bindings/misc/inmys,board-id.yaml	2026-11-11 06:30:52.646446194 +0000
@@ -0,0 +1,47 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/misc/inmys,board-id.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: INMYS board ID reader
+
+maintainers:
+  - TODO Name <TODO@example.com>
+
+description: |
+  A board revision is encoded with strap resistors on a set of GPIO lines.
+  The driver reads the lines once at probe time and exposes the resulting
+  number as the "board_id" sysfs attribute.
+
+  The first GPIO in "board-id-gpios" is the most significant bit and the last
+  one is the least significant bit. The meaning of each value is defined by
+  the board vendor and is not encoded in the Device Tree.
+
+properties:
+  compatible:
+    const: inmys,board-id
+
+  board-id-gpios:
+    description:
+      GPIOs carrying the board ID, ordered from the most significant bit to
+      the least significant bit.
+    minItems: 1
+    maxItems: 32
+
+required:
+  - compatible
+  - board-id-gpios
+
+additionalProperties: false
+
+examples:
+  - |
+    #include <dt-bindings/gpio/gpio.h>
+
+    board-id {
+        compatible = "inmys,board-id";
+        board-id-gpios = <&gpio3 20 GPIO_ACTIVE_HIGH>,  /* BRD_ID2, MSB */
+                         <&gpio3 23 GPIO_ACTIVE_HIGH>,  /* BRD_ID1 */
+                         <&gpio3 4 GPIO_ACTIVE_HIGH>;   /* BRD_ID0, LSB */
+    };
diff -urN a/drivers/misc/inmys-board-id.c b/drivers/misc/inmys-board-id.c
--- a/drivers/misc/inmys-board-id.c	1970-01-01 00:00:00.000000000 +0000
+++ b/drivers/misc/inmys-board-id.c	2026-11-11 06:30:52.646446194 +0000
@@ -0,0 +1,99 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * INMYS board ID reader.
+ *
+ * Reads a set of strap GPIOs described by the "board-id-gpios" property and
+ * exposes the resulting number through sysfs ("board_id").
+ *
+ * The first GPIO in the list is the most significant bit, the last one is
+ * the least significant bit. All knowledge about which pin is which lives
+ * in the Device Tree, so the driver can be used on any board.
+ */
+
+#include <linux/delay.h>
+#include <linux/gpio/consumer.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/platform_device.h>
+#include <linux/sysfs.h>
+#include <linux/types.h>
+
+struct inmys_board_id {
+	u32 id;
+};
+
+static ssize_t board_id_show(struct device *dev,
+			     struct device_attribute *attr, char *buf)
+{
+	struct inmys_board_id *b = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%u\n", b->id);
+}
+static DEVICE_ATTR_RO(board_id);
+
+static struct attribute *inmys_board_id_attrs[] = {
+	&dev_attr_board_id.attr,
+	NULL,
+};
+ATTRIBUTE_GROUPS(inmys_board_id);
+
+static int inmys_board_id_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct inmys_board_id *b;
+	struct gpio_descs *descs;
+	unsigned int i;
+	int val;
+
+	b = devm_kzalloc(dev, sizeof(*b), GFP_KERNEL);
+	if (!b)
+		return -ENOMEM;
+
+	descs = devm_gpiod_get_array(dev, "board-id", GPIOD_IN);
+	if (IS_ERR(descs))
+		return dev_err_probe(dev, PTR_ERR(descs),
+				     "cannot get board-id-gpios\n");
+
+	if (descs->ndescs > BITS_PER_TYPE(b->id))
+		return dev_err_probe(dev, -EINVAL,
+				     "too many board-id-gpios: %u (max %zu)\n",
+				     descs->ndescs, BITS_PER_TYPE(b->id));
+
+	/* let the level settle after the pinctrl default state (pull-ups) */
+	usleep_range(1000, 2000);
+
+	/* first GPIO is the MSB */
+	for (i = 0; i < descs->ndescs; i++) {
+		val = gpiod_get_value_cansleep(descs->desc[i]);
+		if (val < 0)
+			return dev_err_probe(dev, val,
+					     "cannot read board-id gpio %u\n", i);
+		b->id = (b->id << 1) | !!val;
+	}
+
+	platform_set_drvdata(pdev, b);
+
+	dev_info(dev, "board_id = %u (read from %u strap gpios)\n\n",
+		 b->id, descs->ndescs);
+
+	return 0;
+}
+
+static const struct of_device_id inmys_board_id_of_match[] = {
+	{ .compatible = "inmys,board-id" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, inmys_board_id_of_match);
+
+static struct platform_driver inmys_board_id_driver = {
+	.probe = inmys_board_id_probe,
+	.driver = {
+		.name = "inmys-board-id",
+		.of_match_table = inmys_board_id_of_match,
+		.dev_groups = inmys_board_id_groups,
+	},
+};
+module_platform_driver(inmys_board_id_driver);
+
+MODULE_DESCRIPTION("INMYS board ID reader");
+MODULE_LICENSE("GPL");
diff -urN a/drivers/misc/Kconfig b/drivers/misc/Kconfig
